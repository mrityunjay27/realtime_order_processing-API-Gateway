# API Gateway — environment configuration
# Copy to .env and adjust if your services run elsewhere.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# Where the gateway forwards HTTP requests. Points at the Django services
# running natively on your Mac. When dockerized, swap these for service DNS:
#   http://order-service:8000  etc.
ORDER_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:8002

# Upstream timeout in seconds — the gateway never waits forever.
GATEWAY_TIMEOUT_SECONDS=10
