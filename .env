# API Gateway — environment configuration
# Copy to .env and adjust if your services run elsewhere.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# Where the gateway forwards HTTP requests. Points at the Django services
# running natively on your Mac. When dockerized, swap these for service DNS:
#   http://order-service:8000  etc.
ORDER_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8000
PAYMENT_SERVICE_URL=http://localhost:8002
AUTH_SERVICE_URL=http://localhost:8003

# Upstream timeout in seconds — the gateway never waits forever.
GATEWAY_TIMEOUT_SECONDS=10

# --- JWT verification (Phase 3) ---
# The gateway holds ONLY the auth service's public key.
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=api-gateway

# --- Development authentication bypass ---
# Bypass requires ALL THREE: ENVIRONMENT=development AND
# DEV_AUTH_BYPASS_ENABLED=true AND X-Dev-Auth matching DEV_AUTH_BYPASS_TOKEN.
# In staging/production set DEV_AUTH_BYPASS_ENABLED=false (or omit it) —
# the X-Dev-Auth header is then ignored as if it did not exist.
ENVIRONMENT=development
DEV_AUTH_BYPASS_ENABLED=true
DEV_AUTH_BYPASS_TOKEN=dev-only-superuser-4f8a2c91e7b3
